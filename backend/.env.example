# ==========================================
# TypeMind AI - Backend Environment Configuration
# ==========================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=true

# Server Network Settings
HOST=127.0.0.1
PORT=8000

# Application Metadata
APP_NAME="TypeMind AI"
APP_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Security & CORS (Comma-separated or JSON list of origins for frontend)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Machine Learning Service Settings
ML_MODEL_PATH=app/ml/artifacts/model.joblib
MIN_CONFIDENCE_THRESHOLD=0.60
